{
	"name": "next-template",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix --max-warnings=0",
		"lint:staged": "lint-staged --fail-on-changes",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"stylelint": "stylelint \"src/**/*.css\"",
		"stylelint:fix": "stylelint \"src/**/*.css\" --fix",
		"deps:check": "depcruise --config .dependency-cruiser.cjs src",
		"unused:check": "knip",
		"quality:check": "npm run format:check && npm run lint && npm run stylelint && npm run deps:check && npm run unused:check",
		"quality:fix": "npm run format && npm run lint:fix && npm run stylelint:fix",
		"prepare": "husky"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@phosphor-icons/react": "^2.1.10",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@reduxjs/toolkit": "^2.11.2",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-virtual": "^3.13.19",
		"axios": "^1.13.2",
		"input-otp": "^1.4.2",
		"lodash": "^4.17.23",
		"next": "16.1.6",
		"prettier": "^3.8.1",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-hook-form": "^7.71.2",
		"react-redux": "^9.2.0",
		"redux-persist": "^6.0.0",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/lodash": "^4.17.24",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.1.6",
		"eslint-plugin-boundaries": "^6.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-sonarjs": "^4.0.3",
		"dependency-cruiser": "^17.4.3",
		"husky": "^9.1.7",
		"knip": "^6.17.1",
		"lint-staged": "^17.0.7",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"stylelint": "^17.13.0",
		"stylelint-config-standard": "^40.0.0",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
